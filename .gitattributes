# Store text with LF line endings so the files build the same on the
# GitHub-hosted Mac as on this Windows PC.
* text=auto

*.sh text eol=lf
*.rb text eol=lf
*.yml text eol=lf
*.swift text eol=lf
*.plist text eol=lf
*.pbxproj text eol=lf
*.xcconfig text eol=lf
*.storyboard text eol=lf

*.png binary
*.jpg binary
*.ttf binary
*.otf binary
